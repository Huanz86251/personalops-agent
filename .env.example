# Feishu application
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OWNER_OPEN_ID=

# Cloud model
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
HARD_LLM_PROVIDER=deepseek
HARD_LLM_MODEL=deepseek-v4-pro
CLOUD_LLM_MAX_TOKENS=5000

# Local retrieval and memory routing
MEMORY_EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base
MEMORY_RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base
MEMORY_MODEL_DEVICE=auto
MEMORY_MODEL_CACHE_DIR=.models
MEMORY_ROUTER_ENABLED=true
MEMORY_ROUTER_MODEL_REPO=Qwen/Qwen3-1.7B-GGUF
MEMORY_ROUTER_MODEL_FILENAME=Qwen3-1.7B-Q8_0.gguf
MEMORY_ROUTER_CONTEXT_LENGTH=2048
MEMORY_ROUTER_MAX_TOKENS=16

# Web search
WEB_SEARCH_BACKEND=yandex
WEB_SEARCH_REGION=wt-wt

# Local Phoenix tracing
PHOENIX_TRACING_ENABLED=true
PHOENIX_PROJECT=personalops-agent
PHOENIX_UI_URL=http://127.0.0.1:6006
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_OTEL_PROTOCOL=http/protobuf

# Planning budgets
PLANNING_MAX_STEPS_PER_PLAN=4
PLANNING_MAX_TOTAL_STEPS=8
PLANNING_MAX_REPLANS=1
PLANNING_MAX_STEP_MODEL_ROUNDS=10
PLANNING_MAX_STEP_EXECUTOR_ROUNDS=8
PLANNING_MAX_STEP_REPORT_ROUNDS=2
PLANNING_MAX_STEP_TOOL_CALLS=15
PLANNING_MAX_STEP_ATTEMPTS=2
PLANNING_MAX_PLAN_MODEL_ROUNDS=30
PLANNING_MAX_PLAN_TOOL_CALLS=45

# Context compression
PLANNING_HARD_RECENT_DIALOGUE_TURNS=5
PLANNING_HARD_RECENT_DIALOGUE_MAX_CHARS=6000
PLANNING_CONVERSATION_SUMMARY_TRIGGER_TURNS=10
PLANNING_CONVERSATION_SUMMARY_MAX_CHARS=6000
PLANNING_EXECUTOR_SUMMARY_TRIGGER_TOKENS=12000
PLANNING_EXECUTOR_SUMMARY_TRIGGER_MESSAGES=18
PLANNING_EXECUTOR_SUMMARY_KEEP_MESSAGES=6
