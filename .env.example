# Feishu application
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OWNER_OPEN_ID=

# Cloud model
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

LLM_PROVIDER=qwen
LLM_MODEL=qwen3.8-flash
HARD_LLM_PROVIDER=qwen
HARD_LLM_MODEL=qwen3.8-flash
# Qwen defaults: planning and coding use 3.8 low; all auxiliary roles use 3.7 non-thinking.
SUMMARY_LLM_PROVIDER=qwen
SUMMARY_LLM_MODEL=qwen3.8-flash
EXTRACTION_LLM_PROVIDER=qwen
EXTRACTION_LLM_MODEL=qwen3.8-flash
CLOUD_LLM_MAX_TOKENS=5000
SCHEDULER_THINKING_ENABLED=true
LLM_THINKING_ENABLED=true
# 仅作极端保护；记忆第二轮可能批量输出多条结构化记录。
MEMORY_EXTRACTION_MAX_TOKENS=16000

# Local retrieval and memory routing
MEMORY_EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base
MEMORY_RERANKER_MODEL=maidalun1020/bce-reranker-base_v1
MEMORY_RERANKER_THRESHOLD=0.4
# 工具组Cross Encoder绝对最低分；低于该值时进入第二轮或模型回退。
TOOLSET_ROUTING_THRESHOLD=0.4
MEMORY_BM25_LIMIT=8
MEMORY_MODEL_DEVICE=auto
MEMORY_MODEL_CACHE_DIR=.models
# Write Gate只处理用户原话；累计3条后在后台临时加载模型，完成即释放。
MEMORY_WRITE_GATE_ENABLED=true
MEMORY_WRITE_GATE_MODEL=chris0809/memoperator-0.6b-memory-write-gate
MEMORY_WRITE_GATE_DEVICE=cpu
MEMORY_WRITE_GATE_BATCH_SIZE=3
MEMORY_WRITE_GATE_MAX_LENGTH=256
MEMORY_WRITE_GATE_THRESHOLD=0.690976
# 正式提取使用独立云模型；GPT-5 nano使用minimal推理，按10条候选执行两轮协议。
MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_BATCH_SIZE=10
# 旧Qwen Router默认关闭；动态工具组使用现有回退，冲突门后续另行选型。
MEMORY_ROUTER_ENABLED=false
MEMORY_ROUTER_MODEL_REPO=Qwen/Qwen3-1.7B-GGUF
MEMORY_ROUTER_MODEL_FILENAME=Qwen3-1.7B-Q8_0.gguf
MEMORY_ROUTER_CONTEXT_LENGTH=2048
MEMORY_ROUTER_MAX_TOKENS=16

# Local prompt-injection guard for all text returned by Worker tools.
# Wolf Defender Small v2 documents 0.5 and 2048/64 as its evaluation protocol.
# Qwen3Guard-Gen is categorical (Safe/Controversial/Unsafe), so it has no score threshold.
PROMPT_INJECTION_GUARD_ENABLED=true
PROMPT_INJECTION_PRIMARY_MODEL=patronus-studio/wolf-defender-prompt-injection-small
PROMPT_INJECTION_PRIMARY_ONNX_FILE=onnx/int8_int4_embeddings/model.onnx
PROMPT_INJECTION_PRIMARY_THRESHOLD=0.5
PROMPT_INJECTION_PRIMARY_WINDOW_TOKENS=2048
PROMPT_INJECTION_PRIMARY_OVERLAP_TOKENS=64
PROMPT_INJECTION_PRIMARY_BATCH_SIZE=8
PROMPT_INJECTION_SECONDARY_MODEL=Qwen/Qwen3Guard-Gen-0.6B
PROMPT_INJECTION_SECONDARY_WINDOW_TOKENS=512
PROMPT_INJECTION_SECONDARY_OVERLAP_TOKENS=40
PROMPT_INJECTION_SECONDARY_BATCH_SIZE=4
PROMPT_INJECTION_SECONDARY_DEVICE=auto

# Web search
WEB_SEARCH_BACKEND=google
WEB_SEARCH_REGION=wt-wt

# Optional local read-only email MCP (disabled until credentials are supplied).
# QQ/Foxmail: enable IMAP in mailbox settings and use its authorization code,
# never the login password. Keep the real code only in your ignored local .env.
# Other standard IMAP providers can override host/port/folder.
EMAIL_MCP_ENABLED=false
EMAIL_MCP_ADDRESS=
EMAIL_MCP_AUTH_CODE=
EMAIL_MCP_IMAP_HOST=imap.qq.com
EMAIL_MCP_IMAP_PORT=993
EMAIL_MCP_FOLDER=INBOX
EMAIL_MCP_DRAFTS_FOLDER=Drafts
EMAIL_MCP_SECURE=true

# Runtime concurrency policy
RUNTIME_WEB_SEARCH_MAX_PARALLELISM=3
RUNTIME_PLAYWRIGHT_MAX_SESSIONS=3
RUNTIME_CODE_MAX_WRITERS=1
RUNTIME_WORKER_PROGRESS_EVERY_TOOL_CALLS=4
RUNTIME_WORKER_FINALIZATION_MODEL_ROUNDS=1
RUNTIME_WORKER_SCHEMA_REPAIR_MAX_ROUNDS=3
RUNTIME_WEB_DOWNLOAD_MAX_FILE_MIB=20
RUNTIME_LEADERSHIP_SINGLE_WORKER_REPORTS=2
RUNTIME_LEADERSHIP_MULTI_WORKER_REPORTS=1
RUNTIME_LEADERSHIP_SILENCE_TIMEOUT_SECONDS=60
RUNTIME_WORKER_WORKSPACE_RETENTION_MINUTES=14400

# Development default: auto promotes after independent review. Use human to
# require /approve before the Conversation Workspace changes.
RUNTIME_DELIVERY_APPROVAL_MODE=auto

# Local Phoenix tracing
PHOENIX_TRACING_ENABLED=true
PHOENIX_PROJECT=Agent Tasks
PHOENIX_UI_URL=http://127.0.0.1:6006
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_OTEL_PROTOCOL=http/protobuf
# AppWorld私有批次索引钩子；false或--no-monitor可卸下。
APPWORLD_RUN_MONITOR_ENABLED=true
# 连续运行可指定同一批次名；留空时按UTC日期归入adhoc批次。
APPWORLD_MONITOR_BATCH_ID=

# Planning budgets
PLANNING_MAX_STEPS_PER_PLAN=8
PLANNING_MAX_TOTAL_STEPS=16
PLANNING_MAX_REPLANS=2
PLANNING_MAX_STEP_MODEL_ROUNDS=21
PLANNING_MAX_STEP_EXECUTOR_ROUNDS=16
PLANNING_MAX_STEP_REPORT_ROUNDS=5
PLANNING_MAX_STEP_TOOL_CALLS=30
PLANNING_MAX_STEP_ATTEMPTS=2
PLANNING_MAX_PLAN_MODEL_ROUNDS=60
PLANNING_MAX_PLAN_TOOL_CALLS=90

# Context compression
PLANNING_HARD_RECENT_DIALOGUE_TURNS=5
PLANNING_HARD_RECENT_DIALOGUE_MAX_CHARS=6000
PLANNING_CONVERSATION_SUMMARY_TRIGGER_TURNS=10
PLANNING_CONVERSATION_SUMMARY_MAX_CHARS=6000
PLANNING_EXECUTOR_SUMMARY_TRIGGER_TOKENS=12000
# Scheduler 仅清理过程消息；Worker 概括旧执行过程。
SCHEDULER_SUMMARY_TRIGGER_TOKENS=20000
# 当前默认禁用Worker内模型摘要；工具调用和真实返回保持原始对话。
WORKER_COMPACTION_ENABLED=false
WORKER_SUMMARY_TRIGGER_TOKENS=10000
WORKER_SUMMARY_KEEP_MESSAGES=2
WORKER_SUMMARY_KEEP_TOKENS=4000
PLANNING_EXECUTOR_SUMMARY_TRIGGER_MESSAGES=18
PLANNING_EXECUTOR_SUMMARY_KEEP_MESSAGES=6

# Role-owned skill preparation: dynamic, fixed, or off.
# Fixed selections are supplied per role through PlanningContextPack.
# AppWorld explicitly defaults to off; opt in with --skill-routing.
SKILL_ROUTING_MODE=dynamic
# Optional local-file return to Feishu. Empty lists disable export.
# Obtain your IDs using /file_whoami. Configure locally; model arguments cannot grant access.
FEISHU_EXPORT_OWNER_IDS=[]
FEISHU_EXPORT_CHAT_IDS=[]
FEISHU_EXPORT_ROOTS=[]
# Dummy examples (do not grant real access):
# FEISHU_EXPORT_OWNER_IDS=["ou_REPLACE_WITH_OWNER"]
# FEISHU_EXPORT_CHAT_IDS=["oc_REPLACE_WITH_CHAT"]
# FEISHU_EXPORT_ROOTS=["D:/REPLACE_WITH_EXPORT_DIRECTORY"]

# Per-role cloud models. See docs/model-roles.md.
GENERAL_LLM_PROVIDER=qwen
GENERAL_LLM_MODEL=ZHIPU/GLM-5.3-Flash
GENERAL_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
GENERAL_LLM_BASE_URL=
WEB_LLM_PROVIDER=qwen
WEB_LLM_MODEL=qwen3.7-flash
WEB_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
WEB_LLM_BASE_URL=
CODE_LLM_PROVIDER=qwen
CODE_LLM_MODEL=ZHIPU/GLM-5.3-Flash
CODE_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
CODE_LLM_BASE_URL=
CODE_REVIEWER_LLM_PROVIDER=qwen
CODE_REVIEWER_LLM_MODEL=ZHIPU/GLM-5.3-Flash
CODE_REVIEWER_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
CODE_REVIEWER_LLM_BASE_URL=
REPORTER_LLM_PROVIDER=qwen
REPORTER_LLM_MODEL=qwen3.8-flash
REPORTER_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
REPORTER_LLM_BASE_URL=
WEB_REPORTER_LLM_PROVIDER=qwen
WEB_REPORTER_LLM_MODEL=qwen3.8-flash
WEB_REPORTER_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
WEB_REPORTER_LLM_BASE_URL=
SCHEDULER_LLM_PROVIDER=qwen
SCHEDULER_LLM_MODEL=ZHIPU/GLM-5.3-Flash
SCHEDULER_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
SCHEDULER_LLM_BASE_URL=
SCOPE_RESOLVER_LLM_PROVIDER=qwen
SCOPE_RESOLVER_LLM_MODEL=qwen3.8-flash
SCOPE_RESOLVER_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
SCOPE_RESOLVER_LLM_BASE_URL=
SCOPE_RESOLVER_LLM_THINKING_ENABLED=true
SCOPE_RESOLVER_LLM_REASONING_EFFORT=medium
SCOPE_RESOLVER_LLM_MAX_TOKENS=4096
SCOPE_RESOLVER_LLM_MAX_RETRIES=0
SCOPE_RESOLVER_MAX_ATTEMPTS=3
CODE_SCHEDULER_LLM_PROVIDER=qwen
CODE_SCHEDULER_LLM_MODEL=qwen3.8-flash
CODE_SCHEDULER_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
CODE_SCHEDULER_LLM_BASE_URL=
REPLANNER_LLM_PROVIDER=qwen
REPLANNER_LLM_MODEL=qwen3.8-flash
REPLANNER_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
REPLANNER_LLM_BASE_URL=
FINAL_REVIEWER_LLM_PROVIDER=qwen
FINAL_REVIEWER_LLM_MODEL=qwen3.8-flash
FINAL_REVIEWER_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
FINAL_REVIEWER_LLM_BASE_URL=
WORKER_LEADER_LLM_PROVIDER=qwen
WORKER_LEADER_LLM_MODEL=qwen3.8-flash
WORKER_LEADER_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
WORKER_LEADER_LLM_BASE_URL=
TITLE_LLM_PROVIDER=qwen
TITLE_LLM_MODEL=qwen3.8-flash
TITLE_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
TITLE_LLM_BASE_URL=
SUMMARY_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
SUMMARY_LLM_BASE_URL=
GENERAL_SUMMARY_LLM_PROVIDER=qwen
GENERAL_SUMMARY_LLM_MODEL=qwen3.8-flash
GENERAL_SUMMARY_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
GENERAL_SUMMARY_LLM_BASE_URL=
WEB_SUMMARY_LLM_PROVIDER=qwen
WEB_SUMMARY_LLM_MODEL=qwen3.8-flash
WEB_SUMMARY_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
WEB_SUMMARY_LLM_BASE_URL=
CODE_SUMMARY_LLM_PROVIDER=qwen
CODE_SUMMARY_LLM_MODEL=qwen3.8-flash
CODE_SUMMARY_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
CODE_SUMMARY_LLM_BASE_URL=
CODE_REVIEWER_SUMMARY_LLM_PROVIDER=qwen
CODE_REVIEWER_SUMMARY_LLM_MODEL=qwen3.8-flash
CODE_REVIEWER_SUMMARY_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
CODE_REVIEWER_SUMMARY_LLM_BASE_URL=
EXTRACTION_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
EXTRACTION_LLM_BASE_URL=
# qwen3.7-flash: config/model_thinking.json is authoritative for ALL roles.
# thinking_budget > 0 enables thinking; 0 disables it, overriding legacy flags below.
GENERAL_LLM_THINKING_ENABLED=true
GENERAL_LLM_REASONING_EFFORT=low
WEB_LLM_THINKING_ENABLED=true
WEB_LLM_REASONING_EFFORT=
CODE_LLM_THINKING_ENABLED=true
CODE_LLM_REASONING_EFFORT=low
CODE_REVIEWER_LLM_THINKING_ENABLED=true
CODE_REVIEWER_LLM_REASONING_EFFORT=low
REPORTER_LLM_THINKING_ENABLED=true
REPORTER_LLM_REASONING_EFFORT=low
WEB_REPORTER_LLM_THINKING_ENABLED=true
WEB_REPORTER_LLM_REASONING_EFFORT=low
SCHEDULER_LLM_THINKING_ENABLED=true
SCHEDULER_LLM_REASONING_EFFORT=low
CODE_SCHEDULER_LLM_THINKING_ENABLED=true
CODE_SCHEDULER_LLM_REASONING_EFFORT=low
REPLANNER_LLM_THINKING_ENABLED=true
REPLANNER_LLM_REASONING_EFFORT=low
FINAL_REVIEWER_LLM_THINKING_ENABLED=true
FINAL_REVIEWER_LLM_REASONING_EFFORT=low
WORKER_LEADER_LLM_THINKING_ENABLED=true
WORKER_LEADER_LLM_REASONING_EFFORT=low
TITLE_LLM_THINKING_ENABLED=true
TITLE_LLM_REASONING_EFFORT=low
SUMMARY_LLM_THINKING_ENABLED=true
SUMMARY_LLM_REASONING_EFFORT=low
GENERAL_SUMMARY_LLM_THINKING_ENABLED=true
GENERAL_SUMMARY_LLM_REASONING_EFFORT=low
WEB_SUMMARY_LLM_THINKING_ENABLED=true
WEB_SUMMARY_LLM_REASONING_EFFORT=low
CODE_SUMMARY_LLM_THINKING_ENABLED=true
CODE_SUMMARY_LLM_REASONING_EFFORT=low
CODE_REVIEWER_SUMMARY_LLM_THINKING_ENABLED=true
CODE_REVIEWER_SUMMARY_LLM_REASONING_EFFORT=low
EXTRACTION_LLM_THINKING_ENABLED=true
EXTRACTION_LLM_REASONING_EFFORT=low
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Shared model for every dynamic Skill selection (defaults to regular model, thinking off).
# Independent of Scheduler / Code / Reviewer execution model settings.
SKILL_SELECTOR_LLM_MODEL=qwen3.8-flash
SKILL_SELECTOR_LLM_THINKING_ENABLED=false
# SKILL_SELECTOR_LLM_PROVIDER=qwen
# SKILL_SELECTOR_LLM_MAX_TOKENS=1224

SKILL_SELECTOR_LLM_REASONING_EFFORT=

SKILL_SELECTOR_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

GENERAL_LLM_EXTRA_BODY_JSON={"thinking":{"type":"enabled","clear_thinking":true}}

WEB_LLM_EXTRA_BODY_JSON={}

CODE_LLM_EXTRA_BODY_JSON={"thinking":{"type":"enabled","clear_thinking":true}}

CODE_REVIEWER_LLM_EXTRA_BODY_JSON={"thinking":{"type":"enabled","clear_thinking":true}}

REPORTER_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

WEB_REPORTER_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

SCHEDULER_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

CODE_SCHEDULER_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

REPLANNER_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

FINAL_REVIEWER_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

WORKER_LEADER_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

TITLE_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

SUMMARY_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

GENERAL_SUMMARY_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

WEB_SUMMARY_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

CODE_SUMMARY_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

CODE_REVIEWER_SUMMARY_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

EXTRACTION_LLM_EXTRA_BODY_JSON={"preserve_thinking":false}

SKILL_SELECTOR_LLM_MAX_TOKENS=1224

GENERAL_LLM_TOKEN_LIMIT_PARAMETER=max_tokens

CODE_LLM_TOKEN_LIMIT_PARAMETER=max_tokens

CODE_REVIEWER_LLM_TOKEN_LIMIT_PARAMETER=max_tokens
